local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local L={} for i=1,64 do L[B:sub(i,i)]=i-1 end
local function D(s)
    s=s:gsub("[^"..B.."=]","")
    local o,n,a={},0,0
    for i=1,#s do
        local c=s:sub(i,i)
        if c=="=" then break end
        a=a*64+L[c] n=n+6
        while n>=8 do
            n=n-8
            local b=math.floor(a/2^n)%256
            o[#o+1]=string.char(b)
            a=a%2^n
        end
    end
    return table.concat(o)
end
local K=167
local r=D([==[]==])
local t={} for i=1,#r do t[i]=string.char(bit32.bxor(r:byte(i),K)) end
local f=(loadstring or load)(table.concat(t),"")
if f then return f() end
